{
  "name": "chatcom",
  "version": "1.0.0-rc.5",
  "private": true,
  "license": "MIT",
  "author": "Alexandre Balladelli",
  "description": "Reusable local communication relay between Work and Codex.",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "productName": "ChatCOM Desktop",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    }
  },
  "bin": {
    "chatcom": "./dist/portable-cli.js",
    "chatcom-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "!dist/test",
    ".ai/PROOF.md",
    "CODEX-CHATCOM-PROMPT.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "WORK-HOST-PROOF.md",
    "WINDOWS-SIGNING.md",
    "LICENSE",
    "PRIVACY.md",
    "CODE-SIGNING-POLICY.md",
    "THIRD-PARTY-NOTICES.md",
    "SECURITY.md",
    "SIGNPATH-APPLICATION.md",
    "README.md",
    "README.fr.md",
    ".codex/config.toml.example",
    "scripts/differential-diagnostic.mjs",
    "scripts/sdk-diagnostic.mjs",
    "scripts/mcp-diagnostic.mjs",
    "scripts/install-windows.ps1",
    "scripts/verify-windows-signature.ps1",
    "scripts/validate-preview-feed.mjs",
    "scripts/desktop-start-preflight-smoke.mjs",
    "apps",
    "forge.config.cjs",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts",
    "tsconfig.desktop.json",
    "relay.config.example.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test dist/test/app-server-client.test.js dist/test/message-contract.test.js dist/test/local-relay.test.js dist/test/differential-diagnostic.test.js dist/test/codex-sdk-relay.test.js dist/test/portable-relay.test.js dist/test/mcp-server.test.js dist/test/conversation-orchestrator.test.js dist/test/desktop-proof-readiness.test.js dist/test/desktop-rc3.test.js dist/test/desktop-settings.test.js dist/test/desktop-updater.test.js dist/test/signpath-readiness.test.js dist/test/desktop-start.test.js dist/test/work-host-bridge.test.js scripts/differential-diagnostic.test.mjs scripts/desktop-security.test.mjs scripts/desktop-upgrade-synthetic.test.mjs scripts/preview-feed-validation.test.mjs",
    "validate-config": "npm run build && node dist/portable-cli.js validate --config relay.config.example.json",
    "audit": "npm audit --omit=dev --audit-level=high",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json --noEmit",
    "desktop:test": "npm run desktop:typecheck && node --test dist/test/conversation-orchestrator.test.js",
    "desktop:dev": "electron-forge start",
    "desktop:build": "npm run desktop:typecheck && electron-forge package",
    "desktop:package": "electron-forge package",
    "desktop:make": "electron-forge make --platform=win32 --arch=x64",
    "preview:validate": "node scripts/validate-preview-feed.mjs",
    "desktop:settings-smoke": "node scripts/desktop-settings-smoke.mjs",
    "desktop:start-preflight-smoke": "node scripts/desktop-start-preflight-smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run desktop:typecheck && npm test && npm run validate-config && npm run audit && npm pack --dry-run",
    "install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\install-windows.ps1 -AddToUserPath",
    "diagnose:app-server": "node scripts/differential-diagnostic.mjs",
    "diagnose:sdk": "node scripts/sdk-diagnostic.mjs",
    "diagnose:mcp": "node scripts/mcp-diagnostic.mjs",
    "mcp": "node dist/mcp-server.js",
    "prepack": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.149.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "^22.0.0",
    "electron": "43.4.1",
    "typescript": "7.0.2",
    "vite": "6.4.1"
  }
}
